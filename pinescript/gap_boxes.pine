//@version=6
// Opening Gap Boxes (Support / Resistance)
//
// Gaps are always the DAILY gap - between yesterday's daily close and
// today's daily open - fetched via request.security("D", ...) rather than
// the chart's own bars. That means a 5-minute, 1-hour, or weekly chart all
// draw the exact same boxes as the 1-day chart. Boxes use time-based
// coordinates (xloc.bar_time), not bar-index ones, so they land in the
// right place regardless of the chart's timeframe.
//
// A brand-new gap day's box forms right at today's open and keeps
// resizing live all day as price moves, exactly like it would on the
// 1-day chart - shrinking toward whichever side price trades into, or
// disappearing if price fills the gap entirely intraday. The moment the
// symbol's regular session ends (e.g. 1600 ET) that gray box is locked in
// at whatever size it ended the day at, and never changes again except by
// being tested on a later day. This fires from the session clock itself,
// not barstate.isconfirmed, so it lands right at the close on every chart
// timeframe - including the 1-day chart, which otherwise wouldn't confirm
// today's bar until tomorrow's bar starts forming. Boxes formed on
// EARLIER days - confirming, shrinking, or deleting one - only ever
// update once, at that same market close, using the day's finished OHLC;
// they never change shape or color intraday.
//
// Caveat: on timeframes ABOVE 1 day (weekly, monthly), Pine's
// request.security can only sample one daily value per higher-timeframe
// bar, so not every individual daily gap is visible there.
//
// On any later day price touches a box, it turns solid (confirmed) -
// whether that day's close ends back outside the box or just lands inside
// it, in which case the box also shrinks to be even with that close. It is
// deleted the day price closes all the way through it.
//
// Screener use: each "Screener: ..." alertcondition() below shows up in
// Pine Screener with its own True toggle - just add this script and switch
// the column on, no manual "= 1" filter setup needed. "Inside Support/
// Resistance Gap" fires when the symbol's close sits inside a CONFIRMED
// green/red box; "50 SMA (Market Close) Inside Support/Resistance Gap"
// fires when the 50 SMA of daily closes itself sits inside one. For the
// 20/50/200 SMAs: "Open Above/Below <N> SMA" fires on today's open vs.
// that SMA; "Within 5% of <N> SMA" fires when the current price is within
// +/-5% of it; "Price Crossed <N> SMA" fires on the bar price crosses it
// in either direction.
indicator("Opening Gap Boxes (Support/Resistance)", shorttitle = "GapBoxes", overlay = true, max_boxes_count = 500)

extendRight = input.bool(true, "Extend boxes to the right")

colSupportUnfilled     = input.color(color.new(color.gray, 75), "Support gap - untested", group = "Colors")
colSupportConfirmed    = input.color(color.new(color.lime, 75), "Support gap - confirmed", group = "Colors")
colResistanceUnfilled  = input.color(color.new(color.gray, 75), "Resistance gap - untested", group = "Colors")
colResistanceConfirmed = input.color(color.new(color.red, 75), "Resistance gap - confirmed", group = "Colors")

borderWidth                  = input.int(1, "Box border width", minval = 1, maxval = 5, group = "Borders")
colUntestedBorder            = input.color(color.gray, "Untested gap border", group = "Borders")
colSupportConfirmedBorder    = input.color(color.green, "Support gap - confirmed border", group = "Borders")
colResistanceConfirmedBorder = input.color(color.red, "Resistance gap - confirmed border", group = "Borders")

maxTrackedBoxes = 240 // per side; keeps our arrays in sync with indicator's own max_boxes_count

[dTime, dOpen, dHigh, dLow, dClose, dSma50] = request.security(syminfo.tickerid, "D", [time, open, high, low, close, ta.sma(close, 50)], lookahead = barmerge.lookahead_off)

// True from the instant the symbol's regular session ends (e.g. 1600 ET)
// until it reopens - sampled at 1-minute resolution so it flips the moment
// the close happens, regardless of what timeframe the chart itself is on.
regularSessionOver = request.security(syminfo.tickerid, "1", na(time(timeframe.period, session.regular)), lookahead = barmerge.lookahead_off)

var box[]    supportBoxes     = array.new_box()
var float[]  supportTop       = array.new_float()
var float[]  supportBottom    = array.new_float()
var bool[]   supportConfirmed = array.new_bool()
var int[]    supportBirth     = array.new_int()

var box[]    resBoxes     = array.new_box()
var float[]  resTop       = array.new_float()
var float[]  resBottom    = array.new_float()
var bool[]   resConfirmed = array.new_bool()
var int[]    resBirth     = array.new_int()

// State carried from the last day we finalized, so the next one knows
// both its own gap baseline (lastDayClose) and where its box's left edge
// belongs (lastDayTime).
var float lastDayClose = na
var int   lastDayTime  = na

// Today's still-forming gray box, live-updated every bar until the day closes.
var box    pendingBox  = na
var int    pendingDay  = na
var string pendingSide = na

// Latches true once today's boxes have been finalized, so dayComplete can
// only fire once per day even though regularSessionOver stays true for
// the rest of the day (and through pre-market tomorrow).
var bool dayFinalized = false

enteredSupport         = false
enteredResistance      = false
filledThroughSupport   = false
filledThroughResistance = false

// A new day has begun (dTime just changed): decide whether today is a gap
// day at all, using today's now-known open vs. the last finalized close.
isNewDay = na(pendingDay) or dTime != pendingDay
if isNewDay
    pendingDay := dTime
    pendingBox := na
    pendingSide := na
    dayFinalized := false
    if not na(lastDayClose)
        if dOpen > lastDayClose
            pendingSide := "support"
        else if dOpen < lastDayClose
            pendingSide := "resistance"

// ---- form/grow/shrink/drop today's gap box live, every bar, using today's running low/high ----
if pendingSide == "support"
    topCandidate = math.min(dOpen, dLow)
    if topCandidate > lastDayClose
        if na(pendingBox)
            pendingBox := box.new(lastDayTime, topCandidate, dTime, lastDayClose, xloc = xloc.bar_time, border_color = colUntestedBorder, border_width = borderWidth, bgcolor = colSupportUnfilled, extend = extendRight ? extend.right : extend.none)
            array.push(supportBoxes, pendingBox)
            array.push(supportTop, topCandidate)
            array.push(supportBottom, lastDayClose)
            array.push(supportConfirmed, false)
            array.push(supportBirth, dTime)
        else
            box.set_top(pendingBox, topCandidate)
            array.set(supportTop, array.size(supportTop) - 1, topCandidate)
    else if not na(pendingBox) // price has traded all the way back through the gap intraday
        box.delete(pendingBox)
        array.pop(supportBoxes)
        array.pop(supportTop)
        array.pop(supportBottom)
        array.pop(supportConfirmed)
        array.pop(supportBirth)
        pendingBox := na

if pendingSide == "resistance"
    bottomCandidate = math.max(dOpen, dHigh)
    if bottomCandidate < lastDayClose
        if na(pendingBox)
            pendingBox := box.new(lastDayTime, lastDayClose, dTime, bottomCandidate, xloc = xloc.bar_time, border_color = colUntestedBorder, border_width = borderWidth, bgcolor = colResistanceUnfilled, extend = extendRight ? extend.right : extend.none)
            array.push(resBoxes, pendingBox)
            array.push(resTop, lastDayClose)
            array.push(resBottom, bottomCandidate)
            array.push(resConfirmed, false)
            array.push(resBirth, dTime)
        else
            box.set_bottom(pendingBox, bottomCandidate)
            array.set(resBottom, array.size(resBottom) - 1, bottomCandidate)
    else if not na(pendingBox)
        box.delete(pendingBox)
        array.pop(resBoxes)
        array.pop(resTop)
        array.pop(resBottom)
        array.pop(resConfirmed)
        array.pop(resBirth)
        pendingBox := na

// Fires exactly once, the moment the regular session ends (e.g. 1600 ET) -
// on any chart timeframe, including the 1-day chart itself, since it
// doesn't depend on barstate.isconfirmed (which wouldn't go true on a
// daily bar until tomorrow's bar starts forming).
dayComplete = regularSessionOver and not dayFinalized

if dayComplete
    dayFinalized := true
    dayHigh  = dHigh
    dayLow   = dLow
    dayClose = dClose
    dayTime  = dTime

    // ---- test/shrink/confirm/eliminate boxes formed on earlier days, using the day that just finished ----
    // (today's own box, if any, was formed live above and is skipped here
    // via the birth-day guard, so it's never tested on the day it forms)
    if array.size(supportBoxes) > 0
        for i = array.size(supportBoxes) - 1 to 0
            if array.get(supportBirth, i) != dayTime
                top = array.get(supportTop, i)
                bot = array.get(supportBottom, i)
                bx  = array.get(supportBoxes, i)
                if dayLow <= top
                    enteredSupport := true
                    if dayClose < bot
                        filledThroughSupport := true
                        box.delete(bx)
                        array.remove(supportBoxes, i)
                        array.remove(supportTop, i)
                        array.remove(supportBottom, i)
                        array.remove(supportConfirmed, i)
                        array.remove(supportBirth, i)
                    else
                        // any touch that doesn't close all the way through confirms the box,
                        // whether price closes back above it or just inside it
                        if not array.get(supportConfirmed, i)
                            array.set(supportConfirmed, i, true)
                            box.set_bgcolor(bx, colSupportConfirmed)
                            box.set_border_color(bx, colSupportConfirmedBorder)
                        if dayClose < top
                            array.set(supportTop, i, dayClose)
                            box.set_top(bx, dayClose)

    if array.size(resBoxes) > 0
        for i = array.size(resBoxes) - 1 to 0
            if array.get(resBirth, i) != dayTime
                top = array.get(resTop, i)
                bot = array.get(resBottom, i)
                bx  = array.get(resBoxes, i)
                if dayHigh >= bot
                    enteredResistance := true
                    if dayClose > top
                        filledThroughResistance := true
                        box.delete(bx)
                        array.remove(resBoxes, i)
                        array.remove(resTop, i)
                        array.remove(resBottom, i)
                        array.remove(resConfirmed, i)
                        array.remove(resBirth, i)
                    else
                        // any touch that doesn't close all the way through confirms the box,
                        // whether price closes back below it or just inside it
                        if not array.get(resConfirmed, i)
                            array.set(resConfirmed, i, true)
                            box.set_bgcolor(bx, colResistanceConfirmed)
                            box.set_border_color(bx, colResistanceConfirmedBorder)
                        if dayClose > bot
                            array.set(resBottom, i, dayClose)
                            box.set_bottom(bx, dayClose)

    // ---- bound memory so tracked boxes never outrun the indicator's own box cap ----
    if array.size(supportBoxes) > maxTrackedBoxes
        box.delete(array.get(supportBoxes, 0))
        array.remove(supportBoxes, 0)
        array.remove(supportTop, 0)
        array.remove(supportBottom, 0)
        array.remove(supportConfirmed, 0)
        array.remove(supportBirth, 0)

    if array.size(resBoxes) > maxTrackedBoxes
        box.delete(array.get(resBoxes, 0))
        array.remove(resBoxes, 0)
        array.remove(resTop, 0)
        array.remove(resBottom, 0)
        array.remove(resConfirmed, 0)
        array.remove(resBirth, 0)

    lastDayClose := dayClose
    lastDayTime  := dayTime

// ---- Pine Screener booleans: is the current close inside a CONFIRMED (colored) box? ----
insideSupportGap = false
if array.size(supportBoxes) > 0
    for i = 0 to array.size(supportBoxes) - 1
        if array.get(supportConfirmed, i) and close >= array.get(supportBottom, i) and close <= array.get(supportTop, i)
            insideSupportGap := true

insideResistanceGap = false
if array.size(resBoxes) > 0
    for i = 0 to array.size(resBoxes) - 1
        if array.get(resConfirmed, i) and close >= array.get(resBottom, i) and close <= array.get(resTop, i)
            insideResistanceGap := true

// ---- Pine Screener booleans: does the 50 SMA (of daily closes, at market close) sit inside a CONFIRMED box? ----
sma50InsideSupportGap = false
if array.size(supportBoxes) > 0
    for i = 0 to array.size(supportBoxes) - 1
        if array.get(supportConfirmed, i) and dSma50 >= array.get(supportBottom, i) and dSma50 <= array.get(supportTop, i)
            sma50InsideSupportGap := true

sma50InsideResistanceGap = false
if array.size(resBoxes) > 0
    for i = 0 to array.size(resBoxes) - 1
        if array.get(resConfirmed, i) and dSma50 >= array.get(resBottom, i) and dSma50 <= array.get(resTop, i)
            sma50InsideResistanceGap := true

currentPrice = close // close is the live, continuously-updating price on the forming bar

sma20 = ta.sma(close, 20)
openAboveSma20 = open > sma20
openBelowSma20 = open < sma20
priceWithinSma20Band = math.abs(currentPrice - sma20) / sma20 <= 0.05
crossedSma20 = ta.cross(currentPrice, sma20)

sma50 = ta.sma(close, 50)
openAboveSma50 = open > sma50
openBelowSma50 = open < sma50
priceWithinSma50Band = math.abs(currentPrice - sma50) / sma50 <= 0.05
crossedSma50 = ta.cross(currentPrice, sma50)

sma200 = ta.sma(close, 200)
openAboveSma200 = open > sma200
openBelowSma200 = open < sma200
priceWithinSma200Band = math.abs(currentPrice - sma200) / sma200 <= 0.05
crossedSma200 = ta.cross(currentPrice, sma200)

// alertcondition() takes the boolean directly, so Pine Screener shows a
// native "True" toggle for each of these - no plot cast or manual "= 1"
// filter setup needed.
alertcondition(insideSupportGap, title = "Screener: Inside Support Gap (Green Box)", message = "{{ticker}}: inside a confirmed support gap box")
alertcondition(insideResistanceGap, title = "Screener: Inside Resistance Gap (Red Box)", message = "{{ticker}}: inside a confirmed resistance gap box")
alertcondition(sma50InsideSupportGap, title = "Screener: 50 SMA (Market Close) Inside Support Gap", message = "{{ticker}}: 50 SMA of daily closes sits inside a confirmed support gap box")
alertcondition(sma50InsideResistanceGap, title = "Screener: 50 SMA (Market Close) Inside Resistance Gap", message = "{{ticker}}: 50 SMA of daily closes sits inside a confirmed resistance gap box")

alertcondition(openAboveSma20, title = "Screener: Open Above 20 SMA", message = "{{ticker}}: open above the 20 SMA")
alertcondition(openBelowSma20, title = "Screener: Open Below 20 SMA", message = "{{ticker}}: open below the 20 SMA")
alertcondition(priceWithinSma20Band, title = "Screener: Within 5% of 20 SMA", message = "{{ticker}}: price within 5% of the 20 SMA")
alertcondition(crossedSma20, title = "Screener: Price Crossed 20 SMA", message = "{{ticker}}: price crossed the 20 SMA")

alertcondition(openAboveSma50, title = "Screener: Open Above 50 SMA", message = "{{ticker}}: open above the 50 SMA")
alertcondition(openBelowSma50, title = "Screener: Open Below 50 SMA", message = "{{ticker}}: open below the 50 SMA")
alertcondition(priceWithinSma50Band, title = "Screener: Within 5% of 50 SMA", message = "{{ticker}}: price within 5% of the 50 SMA")
alertcondition(crossedSma50, title = "Screener: Price Crossed 50 SMA", message = "{{ticker}}: price crossed the 50 SMA")

alertcondition(openAboveSma200, title = "Screener: Open Above 200 SMA", message = "{{ticker}}: open above the 200 SMA")
alertcondition(openBelowSma200, title = "Screener: Open Below 200 SMA", message = "{{ticker}}: open below the 200 SMA")
alertcondition(priceWithinSma200Band, title = "Screener: Within 5% of 200 SMA", message = "{{ticker}}: price within 5% of the 200 SMA")
alertcondition(crossedSma200, title = "Screener: Price Crossed 200 SMA", message = "{{ticker}}: price crossed the 200 SMA")

alertcondition(enteredSupport or enteredResistance, title = "Price entered a gap box", message = "{{ticker}}: price entered a gap box")
alertcondition(enteredSupport, title = "Price entered support gap (green box)", message = "{{ticker}}: price entered a support gap box")
alertcondition(enteredResistance, title = "Price entered resistance gap (red box)", message = "{{ticker}}: price entered a resistance gap box")
alertcondition(filledThroughSupport or filledThroughResistance, title = "Price moved through an entire gap box", message = "{{ticker}}: price closed completely through a gap box")
alertcondition(filledThroughSupport, title = "Support gap box fully filled", message = "{{ticker}}: price closed below its support gap box")
alertcondition(filledThroughResistance, title = "Resistance gap box fully filled", message = "{{ticker}}: price closed above its resistance gap box")
