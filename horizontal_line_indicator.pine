//@version=5
indicator("Horizontal Lines Every $2.50", overlay=true, max_lines_count=500)

// ─── Inputs ─────────────────────────────────────────────────────────────
interval    = input.float(2.50, title="Line Interval ($)", minval=0.01, step=0.5)
lookback    = input.int(500, title="Lookback Bars", minval=10, maxval=5000, tooltip="Number of bars used to determine the visible high/low range")
maxLines    = input.int(200, title="Max Lines to Draw", minval=1, maxval=500, tooltip="Safety cap on how many levels are drawn")
lineColorIn = input.color(color.new(color.gray, 60), title="Line Color")
lineWidth   = input.int(1, title="Line Width", minval=1, maxval=4)
lineStyleIn = input.string("Dashed", title="Line Style", options=["Solid", "Dashed", "Dotted"])
showLabels  = input.bool(true, title="Show Price Labels")

lineStyle = lineStyleIn == "Solid" ? line.style_solid : lineStyleIn == "Dotted" ? line.style_dotted : line.style_dashed

// ─── State ──────────────────────────────────────────────────────────────
var line[]  hLines  = array.new_line()
var label[] hLabels = array.new_label()

// ─── Draw / redraw on the last bar ─────────────────────────────────────
if barstate.islast
    // clear previously drawn objects
    if array.size(hLines) > 0
        for i = 0 to array.size(hLines) - 1
            line.delete(array.get(hLines, i))
        array.clear(hLines)
    if array.size(hLabels) > 0
        for i = 0 to array.size(hLabels) - 1
            label.delete(array.get(hLabels, i))
        array.clear(hLabels)

    hi = ta.highest(high, lookback)
    lo = ta.lowest(low, lookback)

    startLevel = math.floor(lo / interval) * interval
    endLevel   = math.ceil(hi / interval) * interval

    level = startLevel
    count = 0
    while level <= endLevel and count < maxLines
        ln = line.new(x1=bar_index - lookback, y1=level, x2=bar_index, y2=level, xloc=xloc.bar_index, extend=extend.right, color=lineColorIn, width=lineWidth, style=lineStyle)
        array.push(hLines, ln)

        if showLabels
            lb = label.new(x=bar_index, y=level, text=str.tostring(level, format.mintick), style=label.style_label_left, color=color.new(color.gray, 100), textcolor=lineColorIn, size=size.small)
            array.push(hLabels, lb)

        level := level + interval
        count := count + 1
